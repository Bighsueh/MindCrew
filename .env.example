# 資料庫
DATABASE_URL=postgresql+asyncpg://dtai:dtai@localhost:5433/dtai
REDIS_URL=redis://localhost:6379/0

# Yjs Sidecar
SIDECAR_URL=http://localhost:4000

# JWT
JWT_SECRET_KEY=your-secret-key-change-in-production
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# LLM provider 設定 — Phase 25 起以 DB 為唯一真理來源
# admin 第一次登入後請到 /admin/providers 新增 provider（vLLM / Azure OpenAI）
# 沒有預設 fallback endpoint / API key。

# LLM 限制
LLM_MAX_TOKENS_PER_CALL=1024
LLM_PROJECT_RPM_LIMIT=30
LLM_GLOBAL_RPM_LIMIT=116
LLM_CALL_TIMEOUT_SECONDS=10

# Embedding (Qwen3-Embedding-8B)
EMBEDDING_BASE_URL=https://embedding.example.com/v1
EMBEDDING_MODEL=Qwen/Qwen3-Embedding-8B
EMBEDDING_API_KEY=your-embedding-api-key

# 應用
APP_ENV=development
CORS_ORIGINS=http://localhost:5173

# Phase 26 / S2 — Fernet master key (url-safe base64, 32 bytes) for at-rest
# encryption of llm_providers.api_key. Generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
LLM_PROVIDER_KEY_MASTER=

# Admin user seed (used once by migration d2e3f4a5b6c7).
# Min length 8. Pick a strong, unique value before first migration.
INITIAL_ADMIN_PASSWORD=

# E2E test credentials (used by Playwright specs in /e2e).
# Set to match the admin / test users that exist in your dev DB.
E2E_ADMIN_PASSWORD=
E2E_TEST_PASSWORD=
E2E_TEACHER_PASSWORD=

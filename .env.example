# 資料庫
DATABASE_URL=postgresql+asyncpg://dtai:dtai@localhost:5433/dtai
REDIS_URL=redis://localhost:6379/0

# Yjs Sidecar
SIDECAR_URL=http://localhost:4000

# JWT
JWT_SECRET_KEY=your-secret-key-change-in-production
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# LLM（Primary：vLLM）
LLM_PROVIDER=vllm
VLLM_BASE_URL=https://vllm.example.com/v1
VLLM_MODEL_NAME=/models/gemma-4-26B-A4B-it
VLLM_API_KEY=dummy

# LLM Fallback（可選）
# LLM_FALLBACK_PROVIDER=azure_openai
# AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com/
# AZURE_OPENAI_API_KEY=your-api-key
# AZURE_OPENAI_DEPLOYMENT=gpt-4o
# AZURE_OPENAI_API_VERSION=2024-06-01

# LLM 限制
LLM_MAX_TOKENS_PER_CALL=1024
LLM_PROJECT_RPM_LIMIT=30
LLM_GLOBAL_RPM_LIMIT=300
LLM_CALL_TIMEOUT_SECONDS=10

# Embedding (Qwen3-Embedding-8B)
EMBEDDING_BASE_URL=https://embedding.example.com/v1
EMBEDDING_MODEL=Qwen/Qwen3-Embedding-8B
EMBEDDING_API_KEY=your-embedding-api-key

# 應用
APP_ENV=development
CORS_ORIGINS=http://localhost:5173

# LLM call total timeout (seconds). Applies to non-stream completion and to
# stream chunk iteration after the connection is established.
LLM_CALL_TIMEOUT_SECONDS=60

# Streaming connect timeout (seconds). Applies only to the initial
# `chat.completions.create(..., stream=True)` await. Chunk iteration uses
# LLM_CALL_TIMEOUT_SECONDS.
LLM_STREAM_CONNECT_TIMEOUT_SECONDS=15
